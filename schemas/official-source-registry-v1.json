{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "official-source-registry-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "policy_id", "topic", "approval_status", "entries"],
  "properties": {
    "registry_version": { "const": "official-source-registry-v1" },
    "policy_id": { "const": "official-devops-tools-v1" },
    "topic": { "const": "devops-tools" },
    "approval_status": { "enum": ["pending", "approved"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "fact_id", "display_name", "verification", "allowed_https_domain", "allowed_path_prefixes", "canonical_official_url", "canonical_source_url", "redirect_policy"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "fact_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "display_name": { "type": "string" },
          "verification": { "enum": ["pending_authoritative_verification", "verified"] },
          "allowed_https_domain": { "type": ["string", "null"] },
          "allowed_path_prefixes": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "canonical_official_url": { "type": ["string", "null"] },
          "canonical_source_url": { "type": ["string", "null"] },
          "redirect_policy": { "const": "same_approved_domain_only" }
        }
      }
    }
  }
}
