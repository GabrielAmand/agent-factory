{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-bundle-v1",
  "type": "object", "additionalProperties": false,
  "required": ["bundle_version", "source_policy", "facts"],
  "properties": {
    "bundle_version": { "const": "fact-bundle-v1" },
    "source_policy": { "enum": ["official-devops-tools-v1", "official-devops-tools-v2"] },
    "facts": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_id", "display_name", "description", "tags", "official_url", "source_url", "source_ids"],
        "properties": {
          "fact_id": { "type": "string" }, "display_name": { "type": "string" }, "description": { "type": "string" },
          "tags": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } },
          "official_url": { "type": "string" }, "source_url": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        }
      }
    }
  }
}
