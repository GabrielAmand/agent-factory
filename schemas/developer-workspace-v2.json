{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "developer-workspace-v2",
  "type": "object", "additionalProperties": false,
  "required": ["response_version", "task_id", "files"],
  "properties": {
    "response_version": { "const": "developer-workspace-v2" },
    "task_id": { "type": "string" },
    "files": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "content"],
        "properties": { "path": { "enum": ["index.html", "app.js", "styles.css"] }, "content": { "type": "string" } }
      }
    }
  }
}
