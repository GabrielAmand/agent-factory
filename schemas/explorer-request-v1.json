{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explorer-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "topic", "source_policy", "retrieved_document"],
  "properties": {
    "request_version": { "const": "explorer-request-v1" },
    "topic": { "const": "devops-tools" },
    "source_policy": { "enum": ["official-devops-tools-v1", "official-devops-tools-v2"] },
    "retrieved_document": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "display_name", "source_id", "official_url", "source_url", "normalized_text"],
      "properties": {
        "fact_id": { "type": "string" },
        "display_name": { "type": "string" },
        "source_id": { "type": "string" },
        "official_url": { "type": "string" },
        "source_url": { "type": "string" },
        "normalized_text": { "type": "string" }
      }
    }
  }
}
